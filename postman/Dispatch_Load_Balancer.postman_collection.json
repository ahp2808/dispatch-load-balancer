            "url": {
              "raw": "{{baseUrl}}/api/dispatch/vehicles/vehicle-1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "vehicles", "vehicle-1"]
            }
          }
        },
        {
          "name": "Delete Vehicle by ID",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/vehicles/vehicle-1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "vehicles", "vehicle-1"]
            }
          }
        },
        {
          "name": "Clear All Vehicles",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "vehicles"]
            }
          }
        }
      ]
    },
    {
      "name": "Validation & Errors",
      "item": [
        {
          "name": "Unsupported Media Type (415)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "text/plain" }
            ],
            "body": {
              "mode": "raw",
              "raw": "plain-text-payload"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "orders"]
            }
          }
        },
        {
          "name": "Order Not Found (404)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/orders/nonexistent-order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "orders", "nonexistent-order"]
            }
          }
        },
        {
          "name": "Invalid Priority (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orders\": [\n    {\n      \"orderId\": \"order-invalid\",\n      \"latitude\": 28.6510,\n      \"longitude\": 77.1900,\n      \"address\": \"Sample Location\",\n      \"packageWeight\": 25,\n      \"priority\": \"URGENT\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "orders"]
            }
          }
        },
        {
          "name": "Negative Capacity (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicles\": [\n    {\n      \"vehicleId\": \"vehicle-invalid\",\n      \"capacity\": -50,\n      \"currentLatitude\": 28.6517,\n      \"currentLongitude\": 77.1906,\n      \"currentAddress\": \"Central Depot\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "vehicles"]
            }
          }
        },
        {
          "name": "Out of Range Latitude (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orders\": [\n    {\n      \"orderId\": \"order-invalid-lat\",\n      \"latitude\": 95.5,\n      \"longitude\": 77.1900,\n      \"address\": \"Out of Range Latitude\",\n      \"packageWeight\": 10,\n      \"priority\": \"HIGH\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "orders"]
            }
          }
        }
      ]
    }
  ]
}
