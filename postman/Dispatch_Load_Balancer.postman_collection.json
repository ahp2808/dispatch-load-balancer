            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "orders"]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/orders/order-1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "orders", "order-1"]
            }
          }
        },
        {
          "name": "Delete Order by ID",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/orders/order-1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "orders", "order-1"]
            }
          }
        },
        {
          "name": "Clear All Orders",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dispatch", "orders"]
            }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "List Vehicles",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/vehicles",
